# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Optional: enables the LLM explanation backend and LLM adversarial generation.
# The system falls back to deterministic template explanations without it.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional alternative explanation backend.
ANTHROPIC_API_KEY=
